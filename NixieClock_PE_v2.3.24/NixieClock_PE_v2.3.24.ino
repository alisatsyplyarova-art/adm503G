// ------- "Барабаны игрового автомата" (FM_SLOT / FM_SLOT_ALL) -------
// FM_SLOT: разряды крутятся ПО ОЧЕРЕДИ (только один за раз, слева направо).
// FM_SLOT_ALL: крутятся ВСЕ разряды одновременно, но чем правее разряд,
// тем дольше он крутится - поэтому останавливаются один за другим.
// В обоих случаях цифры на разряде идут ПО ПОРЯДКУ (0,1,2...9,0,1...),
// как на настоящем барабане, и после нужного числа полных проходов
// останавливаются точно на нужном значении - без скачка.
#define SLOT_BASE_CYCLES    2                                // минимальное число полных кругов 0..9 перед остановкой
#define SLOT_STEP_CYCLES    1                                // (только FM_SLOT_ALL) на сколько кругов дольше крутится каждый следующий разряд
#define SLOT_JITTER_CYCLES  1                                // случайный разброс числа кругов (0..SLOT_JITTER_CYCLES)

